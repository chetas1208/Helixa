# HELIXA local configuration template. Placeholders only.
# Copy to .env and fill secrets there. .env is gitignored and must not be committed.
# Do not put private credentials in VITE_ variables; those are visible in the browser bundle.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=5173
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=diamond_genome
MONGODB_APP_NAME=diamond-genome
# Display name only. Does not rename MONGODB_DATABASE or historical ids.
HELIXA_APP_NAME=HELIXA
HELIXA_DISPLAY_NAME=HELIXA
# Leave empty. If set and different from MONGODB_DATABASE, MONGODB_DATABASE wins.
HELIXA_DATABASE_NAME=
# Optional label for new artifact metadata. Does not move existing files.
HELIXA_ARTIFACT_NAMESPACE=
MODEL_PROVIDER=deterministic
MODEL_API_PROTOCOL=openai-compatible
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=60
RAINDROP_ENABLED=false
RAINDROP_WRITE_KEY=
RAINDROP_PROJECT_ID=
RAINDROP_ENDPOINT=
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Server STT is separate from ElevenLabs (TTS only). Leave unset → /api/voice/transcribe is 501.
STT_ENABLED=false
STT_PROVIDER=
STT_API_KEY=
# Optional LLM may only suggest interpret intents. Off = grammar only; never authoritative.
GENOME_EDIT_LLM_SUGGEST=false
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_STORAGE_PATH=./artifacts
MAX_UPLOAD_MB=25
ENABLE_VECTOR_SEARCH=false
ENABLE_WORKER_RECOVERY=true
ENABLE_DNA_BACKGROUND=true
ENABLE_VOICE_BRIEFINGS=true

# V10 population studio. Empty values stay unconfigured. Do not put secrets here.
EVOLUTION_ENGINE=wright_fisher
SLIM_EXECUTABLE=
SIMULATION_MAX_GENERATIONS=2000
SIMULATION_MAX_REPLICATES=20
SIMULATION_MAX_SECONDS=180
EVOLUTION_ARTIFACT_PATH=./artifacts/v10
NASA_POWER_ENABLED=false
GENOME_REFERENCE_CACHE_PATH=./artifacts/references
OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=0

# MongoDB Atlas Voyage embeddings and reranking. Not a chat key, database URI, or Atlas Admin key.
# Leave the key empty. A present key is not proof of connectivity.
VOYAGE_ENABLED=false
VOYAGE_API_KEY=
VOYAGE_BASE_URL=https://ai.mongodb.com/v1
# Optional: unscoped, us, or eu. Must match VOYAGE_BASE_URL. Empty follows the URL host.
VOYAGE_KEY_SCOPE=
VOYAGE_EMBEDDING_MODEL=voyage-4-large
VOYAGE_FAST_MODEL=voyage-4-lite
VOYAGE_RERANK_MODEL=rerank-3
VOYAGE_TIMEOUT_SECONDS=30
VOYAGE_MAX_RETRIES=3
VOYAGE_BATCH_SIZE=32
VOYAGE_MAX_INPUT_CHARS=8000
VOYAGE_ALLOW_EXTERNAL_RESEARCH_TEXT=false
